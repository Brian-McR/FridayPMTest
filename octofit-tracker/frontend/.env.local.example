# Environment variables for OctoFit Tracker Frontend

# Codespaces environment name
# Set this to your GitHub Codespaces name (e.g., "humble-dollop-q7vj7pjv47g5c6x4v")
# Required for connecting to the backend API in Codespaces
# Leave empty or comment out for localhost development
VITE_CODESPACE_NAME=

# Local API URL (used when VITE_CODESPACE_NAME is not set)
# For local development with `npm run dev`
# VITE_API_BASE_URL=http://localhost:8000
